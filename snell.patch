index 0000000..6c789e2
--- /dev/null
+++ b/crates/core-runtime/src/outbound/snell/record.rs
@@ -0,0 +1,1110 @@
+//! snell v4 record framing (reference `snellv4/record.go`): the writer seals
+//! payload slices into salt/header/padding/payload records with the Surge
+//! payload-limit growth window; the reader inverts the framing.
+//!
+//! Both sides expose poll-based primitives so the connection stream can drive
+//! them from `AsyncRead`/`AsyncWrite` implementations.
+
+use std::collections::VecDeque;
+use std::io;
+use std::pin::Pin;
+use std::task::{Context, Poll};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use aes_gcm::Aes128Gcm;
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+
+use super::crypto::{
+    AEAD_TAG_LEN, HEADER_CIPHER_LEN, HEADER_PLAIN_LEN, HEADER_VERSION, MAX_PAYLOAD_LEN, NONCE_LEN,
+    SALT_LEN, derive_key, increase_nonce, new_aead, open_in_place, random_bytes, random_int31,
+    seal_region,
+};
+use super::gcm::{BATCH_MAX, BatchSealer, FastOpener};
+
+pub(crate) const FRAME_SIZE: usize = 1460;
+pub(crate) const FIRST_RECORD_OVERHEAD: usize = 55;
+pub(crate) const RESET_RECORD_OVERHEAD: usize = 39;
+pub(crate) const INITIAL_PADDING_MIN: usize = 0x100;
+pub(crate) const INITIAL_PADDING_SPAN: usize = 0x100;
+const FRAME_PAYLOAD_RESET_INTERVAL: i64 = 31;
+
+pub(crate) fn now_unix() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs() as i64)
+        .unwrap_or(0)
+}
+
+// ---------------------------------------------------------------- writer ----
+
+pub(crate) struct RecordWriter<W> {
+    pub(super) inner: W,
+    psk: Vec<u8>,
+    cipher: Option<Aes128Gcm>,
+    sealer: Option<BatchSealer>,
+    nonce: [u8; NONCE_LEN],
+    salt: [u8; SALT_LEN],
+    salt_sent: bool,
+    initial_padding: usize,
+    payload_limit: i64,
+    last_write_unix: i64,
+}
+
+impl<W> RecordWriter<W> {
+    pub(crate) fn new(inner: W, psk: &[u8]) -> Self {
+        Self {
+            inner,
+            psk: psk.to_vec(),
+            cipher: None,
+            sealer: None,
+            nonce: [0; NONCE_LEN],
+            salt: [0; SALT_LEN],
+            salt_sent: false,
+            initial_padding: 0,
+            payload_limit: 0,
+            last_write_unix: 0,
+        }
+    }
+
+    fn initialize(&mut self) -> io::Result<()> {
+        if self.cipher.is_some() {
+            return Ok(());
+        }
+        random_bytes(&mut self.salt)?;
+        let key = derive_key(&self.psk, &self.salt)?;
+        let mut delta = [0u8; 1];
+        random_bytes(&mut delta)?;
+        self.cipher = Some(new_aead(&key));
+        self.sealer = Some(BatchSealer::new(&key));
+        self.nonce = [0; NONCE_LEN];
+        self.initial_padding = INITIAL_PADDING_MIN + (delta[0] as usize % INITIAL_PADDING_SPAN);
+        Ok(())
+    }
+
+    /// Reference `payloadLimitFor`.
+    fn payload_limit_for(&self, now_unix: i64) -> i64 {
+        if !self.salt_sent {
+            return (FRAME_SIZE - FIRST_RECORD_OVERHEAD) as i64 - self.initial_padding as i64;
+        }
+        if self.last_write_unix != 0
+            && now_unix - self.last_write_unix < FRAME_PAYLOAD_RESET_INTERVAL
+            && self.payload_limit > 0
+        {
+            return self.payload_limit;
+        }
+        (FRAME_SIZE - RESET_RECORD_OVERHEAD) as i64
+    }
+
+    /// Reference `advancePayloadLimit`: one growth step per caller write.
+    fn advance_payload_limit(&mut self, payload_limit: i64, now_unix: i64) {
+        self.last_write_unix = now_unix;
+        if payload_limit < MAX_PAYLOAD_LEN as i64 {
+            let next = payload_limit + (FRAME_SIZE - RESET_RECORD_OVERHEAD) as i64;
+            self.payload_limit = next.min(MAX_PAYLOAD_LEN as i64);
+        } else {
+            self.payload_limit = MAX_PAYLOAD_LEN as i64;
+        }
+    }
+
+    fn frame_padding_len(&self, payload_len: usize) -> usize {
+        if self.salt_sent || payload_len == 0 {
+            0
+        } else {
+            self.initial_padding
+        }
+    }
+
+    fn limit_checked(&self, now_unix: i64) -> io::Result<i64> {
+        let payload_limit = self.payload_limit_for(now_unix);
+        if payload_limit <= 0 || payload_limit > MAX_PAYLOAD_LEN as i64 {
+            return Err(io::Error::other("snell: invalid v4 payload limit"));
+        }
+        Ok(payload_limit)
+    }
+
+    /// Split `data` into records for one caller write (reference
+    /// `Write`/`writeBytesLocked`): the limit is computed and advanced once,
+    /// then the whole slice is split with that limit. An empty `data` write
+    /// emits the zero-length EOF record after advancing the window.
+    pub(crate) fn emit(&mut self, now_unix: i64, data: &[u8]) -> io::Result<Vec<Vec<u8>>> {
+        self.initialize()?;
+        let payload_limit = self.limit_checked(now_unix)?;
+        self.advance_payload_limit(payload_limit, now_unix);
+        if data.is_empty() {
+            return Ok(vec![self.make_record(&[], 0)?]);
+        }
+        let mut records = Vec::new();
+        let mut rest = data;
+        while !rest.is_empty() {
+            let len = rest.len().min(payload_limit as usize);
+            let padding_len = self.frame_padding_len(len);
+            records.push(self.make_record(&rest[..len], padding_len)?);
+            rest = &rest[len..];
+        }
+        Ok(records)
+    }
+
+    /// One datagram = one record, erroring instead of splitting (reference
+    /// `WritePacketBuffer`).
+    pub(crate) fn emit_packet(&mut self, now_unix: i64, data: &[u8]) -> io::Result<Vec<u8>> {
+        self.initialize()?;
+        let payload_limit = self.limit_checked(now_unix)?;
+        if data.len() > payload_limit as usize || data.len() > MAX_PAYLOAD_LEN {
+            return Err(io::Error::other("snell: payload length exceeds maximum"));
+        }
+        self.advance_payload_limit(payload_limit, now_unix);
+        let padding_len = self.frame_padding_len(data.len());
+        self.make_record(data, padding_len)
+    }
+
+    /// Reference `makeSliceRecordLocked`: [salt?][sealed header][padding]
+    /// [payload], appended to `out` — no intermediate record Vecs, the seal
+    /// runs directly on the shared output buffer.
+    fn write_record(
+        &mut self,
+        out: &mut Vec<u8>,
+        payload: &[u8],
+        padding_len: usize,
+    ) -> io::Result<()> {
+        self.initialize()?;
+        if payload.len() > MAX_PAYLOAD_LEN || padding_len > MAX_PAYLOAD_LEN {
+            return Err(io::Error::other("snell: v4 record exceeds maximum"));
+        }
+        if payload.is_empty() && padding_len != 0 {
+            return Err(io::Error::other(
+                "snell: zero-length v4 record carries padding",
+            ));
+        }
+        let salt_len = if !self.salt_sent { SALT_LEN } else { 0 };
+        let payload_cipher_len = if payload.is_empty() {
+            0
+        } else {
+            payload.len() + AEAD_TAG_LEN
+        };
+        out.reserve(salt_len + HEADER_CIPHER_LEN + padding_len + payload_cipher_len);
+
+        if salt_len > 0 {
+            out.extend_from_slice(&self.salt);
+            self.salt_sent = true;
+        }
+
+        let mut header = [0u8; HEADER_PLAIN_LEN];
+        header[0] = HEADER_VERSION;
+        header[3..5].copy_from_slice(&(padding_len as u16).to_be_bytes());
+        header[5..7].copy_from_slice(&(payload.len() as u16).to_be_bytes());
+        let mut tag = [0u8; AEAD_TAG_LEN];
+        seal_region(
+            self.cipher.as_ref().expect("snell: writer initialized"),
+            &self.nonce,
+            &mut header,
+            &mut tag,
+        )?;
+        increase_nonce(&mut self.nonce);
+        out.extend_from_slice(&header);
+        out.extend_from_slice(&tag);
+
+        let padding_start = out.len();
+        out.resize(padding_start + padding_len, 0u8);
+        if !payload.is_empty() {
+            let payload_start = padding_start + padding_len;
+            out.extend_from_slice(payload);
+            let mut tag = [0u8; AEAD_TAG_LEN];
+            let payload_end = payload_start + payload.len();
+            seal_region(
+                self.cipher.as_ref().expect("snell: writer initialized"),
+                &self.nonce,
+                &mut out[payload_start..payload_end],
+                &mut tag,
+            )?;
+            increase_nonce(&mut self.nonce);
+            out.extend_from_slice(&tag);
+
+            if padding_len > 0 {
+                let (head, tail) = out.split_at_mut(payload_start);
+                fill_padding(&mut head[padding_start..], tail)?;
+                let limit = padding_len.min(payload_cipher_len);
+                for index in (0..limit).step_by(2) {
+                    out.swap(padding_start + index, payload_start + index);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn make_record(&mut self, payload: &[u8], padding_len: usize) -> io::Result<Vec<u8>> {
+        let mut out = Vec::new();
+        self.write_record(&mut out, payload, padding_len)?;
+        Ok(out)
+    }
+
+    /// Serialize up to [`BATCH_MAX`] records into `out` as one group: the
+    /// headers seal one by one (23 bytes each, not worth scheduling), then
+    /// the payload regions seal together in a single interleaved GHASH pass
+    /// and the padding follows per record. Wire order, nonces and padding
+    /// bytes match serial [`Self::write_record`] calls exactly — the batch
+    /// only changes how the hash chains are scheduled.
+    fn write_records(&mut self, out: &mut Vec<u8>, items: &[(&[u8], usize)]) -> io::Result<()> {
+        debug_assert!(!items.is_empty() && items.len() <= BATCH_MAX);
+        self.initialize()?;
+        for (payload, padding_len) in items {
+            if payload.is_empty() {
+                return Err(io::Error::other("snell: zero-length v4 record in batch"));
+            }
+            if payload.len() > MAX_PAYLOAD_LEN || *padding_len > MAX_PAYLOAD_LEN {
+                return Err(io::Error::other("snell: v4 record exceeds maximum"));
+            }
+        }
+
+        let salt_len = if !self.salt_sent { SALT_LEN } else { 0 };
+        let total = salt_len
+            + items
+                .iter()
+                .map(|(payload, padding_len)| {
+                    HEADER_CIPHER_LEN + padding_len + payload.len() + AEAD_TAG_LEN
+                })
+                .sum::<usize>();
+        out.reserve(total);
+        if salt_len > 0 {
+            out.extend_from_slice(&self.salt);
+            self.salt_sent = true;
+        }
+
+        let base = self.nonce;
+        let mut header_nonce = base;
+        let mut payload_nonce = base;
+        increase_nonce(&mut payload_nonce);
+        let mut ranges = [(0usize, 0usize); BATCH_MAX];
+        let mut nonces = [[0u8; NONCE_LEN]; BATCH_MAX];
+
+        for (k, &(payload, padding_len)) in items.iter().enumerate() {
+            let mut header = [0u8; HEADER_PLAIN_LEN];
+            header[0] = HEADER_VERSION;
+            header[3..5].copy_from_slice(&(padding_len as u16).to_be_bytes());
+            header[5..7].copy_from_slice(&(payload.len() as u16).to_be_bytes());
+            let mut tag = [0u8; AEAD_TAG_LEN];
+            seal_region(
+                self.cipher.as_ref().expect("snell: writer initialized"),
+                &header_nonce,
+                &mut header,
+                &mut tag,
+            )?;
+            increase_nonce(&mut header_nonce);
+            increase_nonce(&mut header_nonce);
+            out.extend_from_slice(&header);
+            out.extend_from_slice(&tag);
+
+            let padding_start = out.len();
+            out.resize(padding_start + padding_len, 0u8);
+            let payload_start = out.len();
+            out.extend_from_slice(payload);
+            ranges[k] = (payload_start, out.len());
+            out.extend_from_slice(&[0u8; AEAD_TAG_LEN]);
+            nonces[k] = payload_nonce;
+            increase_nonce(&mut payload_nonce);
+            increase_nonce(&mut payload_nonce);
+        }
+
+        let mut tags = [[0u8; AEAD_TAG_LEN]; BATCH_MAX];
+        self.sealer
+            .as_ref()
+            .expect("snell: writer initialized")
+            .seal(out, &ranges, items.len(), &nonces, &mut tags);
+
+        for (k, &(payload, padding_len)) in items.iter().enumerate() {
+            let (payload_start, payload_end) = ranges[k];
+            out[payload_end..payload_end + AEAD_TAG_LEN].copy_from_slice(&tags[k]);
+            if padding_len > 0 {
+                let padding_start = payload_start - padding_len;
+                let region_len = payload.len() + AEAD_TAG_LEN;
+                let (head, tail) = out.split_at_mut(payload_start);
+                fill_padding(&mut head[padding_start..], &tail[..region_len])?;
+                let payload_cipher_len = region_len;
+                let limit = padding_len.min(payload_cipher_len);
+                for index in (0..limit).step_by(2) {
+                    out.swap(padding_start + index, payload_start + index);
+                }
+            }
+        }
+
+        self.nonce = header_nonce;
+        Ok(())
+    }
+
+    /// Hot-path twin of [`emit`]: the serialized records are appended to the
+    /// caller's reused buffer instead of being allocated one Vec at a time.
+    /// Records go out in groups of [`BATCH_MAX`] so the payload seals share
+    /// one interleaved GHASH pass.
+    pub(crate) fn emit_into(
+        &mut self,
+        out: &mut Vec<u8>,
+        now_unix: i64,
+        data: &[u8],
+    ) -> io::Result<()> {
+        self.initialize()?;
+        let payload_limit = self.limit_checked(now_unix)?;
+        self.advance_payload_limit(payload_limit, now_unix);
+        if data.is_empty() {
+            return self.write_record(out, &[], 0);
+        }
+        let mut rest = data;
+        while !rest.is_empty() {
+            let mut items: [(&[u8], usize); BATCH_MAX] = [(&[], 0); BATCH_MAX];
+            let mut count = 0;
+            while count < BATCH_MAX && !rest.is_empty() {
+                let len = rest.len().min(payload_limit as usize);
+                let padding_len = if count == 0 {
+                    self.frame_padding_len(len)
+                } else {
+                    0
+                };
+                items[count] = (&rest[..len], padding_len);
+                rest = &rest[len..];
+                count += 1;
+            }
+            self.write_records(out, &items[..count])?;
+        }
+        Ok(())
+    }
+}
+
+impl<W: AsyncWrite + Unpin> RecordWriter<W> {
+    /// Flush complete records, one inner write per record (reference record
+    /// write granularity — obfs framing depends on it).
+    pub(crate) async fn write_all(&mut self, records: Vec<Vec<u8>>) -> io::Result<()> {
+        let mut pending: VecDeque<(Vec<u8>, usize)> = records.into_iter().map(|r| (r, 0)).collect();
+        std::future::poll_fn(|cx| poll_flush(cx, &mut self.inner, &mut pending)).await
+    }
+}
+
+/// Drain `pending` records into `inner`, tracking partial writes.
+///
+/// Records go out coalesced: one syscall per batch instead of one per record.
+/// A snell record is capped at ~16 KiB by the payload window, so a relay write
+/// arrives as a queue of them, and writing them one by one multiplies the
+/// syscalls (and the socket lock hits) by the record count. The batch is copied
+/// into one buffer because the layers below offer no vectored write; the copy
+/// is far cheaper than the syscalls it removes.
+pub(crate) fn poll_flush<W: AsyncWrite + Unpin>(
+    cx: &mut Context<'_>,
+    inner: &mut W,
+    pending: &mut VecDeque<(Vec<u8>, usize)>,
+) -> Poll<io::Result<()>> {
+    loop {
+        if pending.is_empty() {
+            return Poll::Ready(Ok(()));
+        }
+        if pending.len() == 1 {
+            let (record, pos) = pending.front_mut().expect("checked non-empty");
+            while *pos < record.len() {
+                match Pin::new(&mut *inner).poll_write(cx, &record[*pos..]) {
+                    Poll::Pending => return Poll::Pending,
+                    Poll::Ready(Err(e)) => return Poll::Ready(Err(e)),
+                    Poll::Ready(Ok(0)) => {
+                        return Poll::Ready(Err(io::Error::new(
+                            io::ErrorKind::WriteZero,
+                            "snell: failed to write whole record",
+                        )));
+                    }
+                    Poll::Ready(Ok(n)) => *pos += n,
+                }
+            }
+            pending.pop_front();
+            continue;
+        }
+        let total: usize = pending.iter().map(|(r, p)| r.len() - p).sum();
+        let mut merged = Vec::with_capacity(total);
+        for (record, pos) in pending.iter() {
+            merged.extend_from_slice(&record[*pos..]);
+        }
+        match Pin::new(&mut *inner).poll_write(cx, &merged) {
+            Poll::Pending => return Poll::Pending,
+            Poll::Ready(Err(e)) => return Poll::Ready(Err(e)),
+            Poll::Ready(Ok(0)) => {
+                return Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::WriteZero,
+                    "snell: failed to write whole record",
+                )));
+            }
+            Poll::Ready(Ok(mut n)) => {
+                while n > 0 {
+                    let (record, pos) = pending.front_mut().expect("checked non-empty");
+                    let left = record.len() - *pos;
+                    if left <= n {
+                        n -= left;
+                        pending.pop_front();
+                    } else {
+                        *pos += n;
+                        n = 0;
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Drain the shared write buffer `wbuf[*pos..]` into `inner`, resetting both
+/// once fully written. This is the hot-path flush: the records were already
+/// serialized into `wbuf` by `emit_into`, so there is no merge copy here —
+/// one `poll_write` per pump chunk and the buffer keeps its capacity.
+pub(crate) fn poll_flush_wbuf<W: AsyncWrite + Unpin>(
+    cx: &mut Context<'_>,
+    inner: &mut W,
+    wbuf: &mut Vec<u8>,
+    pos: &mut usize,
+) -> Poll<io::Result<()>> {
+    while *pos < wbuf.len() {
+        match Pin::new(&mut *inner).poll_write(cx, &wbuf[*pos..]) {
+            Poll::Pending => return Poll::Pending,
+            Poll::Ready(Err(e)) => return Poll::Ready(Err(e)),
+            Poll::Ready(Ok(0)) => {
+                return Poll::Ready(Err(io::Error::new(
+                    io::ErrorKind::WriteZero,
+                    "snell: failed to write whole record",
+                )));
+            }
+            Poll::Ready(Ok(n)) => *pos += n,
+        }
+    }
+    wbuf.clear();
+    *pos = 0;
+    Poll::Ready(Ok(()))
+}
+
+// ---------------------------------------------------------------- reader ----
+
+enum ReadStage {
+    Salt,
+    Header,
+    Body,
+}
+
+pub(crate) struct RecordReader<R> {
+    cache: ReadAhead<R>,
+    psk: Vec<u8>,
+    cipher: Option<Aes128Gcm>,
+    opener: Option<FastOpener>,
+    nonce: [u8; NONCE_LEN],
+    stage: ReadStage,
+    head: Vec<u8>,
+    head_filled: usize,
+    body: Vec<u8>,
+    body_filled: usize,
+    padding_len: usize,
+    payload_len: usize,
+    eof: bool,
+    fatal: Option<(io::ErrorKind, String)>,
+}
+
+/// Result of reading exactly `buf.len()` bytes: done, or clean EOF with no
+/// bytes read at a record boundary.
+pub(crate) enum Fill {
+    Done,
+    Eof,
+}
+
+/// Readahead wrapper: one transport read feeds several record fills.
+///
+/// A record arrives as a sealed header (23 bytes) followed by its body, and a
+/// pump chunk lands as several records at once — reading each piece straight
+/// from the socket turns every record into two syscalls and keeps the reader
+/// waking per fragment. The cache absorbs the whole chunk and serves header
+/// and body from memory.
+pub(crate) struct ReadAhead<R> {
+    inner: R,
+    raw: Vec<u8>,
+    pos: usize,
+    end: usize,
+}
+
+/// One pump chunk worth of readahead (`RELAY_BUF` is the writer's view of the
+/// same size; the reader cache just matches it).
+const READAHEAD_CAP: usize = 64 * 1024;
+
+impl<R> ReadAhead<R> {
+    pub(crate) fn new(inner: R) -> Self {
+        Self {
+            inner,
+            raw: Vec::new(),
+            pos: 0,
+            end: 0,
+        }
+    }
+}
+
+impl<R: AsyncRead + Unpin> ReadAhead<R> {
+    pub(crate) fn poll_fill(
+        &mut self,
+        cx: &mut Context<'_>,
+        buf: &mut [u8],
+        filled: &mut usize,
+    ) -> Poll<io::Result<Fill>> {
+        while *filled < buf.len() {
+            if self.pos < self.end {
+                let n = (buf.len() - *filled).min(self.end - self.pos);
+                buf[*filled..*filled + n].copy_from_slice(&self.raw[self.pos..self.pos + n]);
+                self.pos += n;
+                *filled += n;
+                continue;
+            }
+            if self.raw.len() != READAHEAD_CAP {
+                self.raw.resize(READAHEAD_CAP, 0u8);
+            }
+            let mut read_buf = ReadBuf::new(&mut self.raw);
+            match Pin::new(&mut self.inner).poll_read(cx, &mut read_buf) {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Err(e)) => return Poll::Ready(Err(e)),
+                Poll::Ready(Ok(())) => {
+                    let n = read_buf.filled().len();
+                    if n == 0 {
+                        return Poll::Ready(if *filled == 0 {
+                            Ok(Fill::Eof)
+                        } else {
+                            Err(io::Error::new(
+                                io::ErrorKind::UnexpectedEof,
+                                "snell: unexpected EOF",
+                            ))
+                        });
+                    }
+                    self.end = n;
+                    self.pos = 0;
+                }
+            }
+        }
+        Poll::Ready(Ok(Fill::Done))
+    }
+}
+
+impl<R: AsyncRead + Unpin> RecordReader<R> {
+    pub(crate) fn new(inner: R, psk: &[u8]) -> Self {
+        Self {
+            cache: ReadAhead::new(inner),
+            psk: psk.to_vec(),
+            cipher: None,
+            opener: None,
+            nonce: [0; NONCE_LEN],
+            stage: ReadStage::Salt,
+            head: Vec::new(),
+            head_filled: 0,
+            body: Vec::new(),
+            body_filled: 0,
+            padding_len: 0,
+            payload_len: 0,
+            eof: false,
+            fatal: None,
+        }
+    }
+
+    fn fail(&mut self, kind: io::ErrorKind, msg: String) -> io::Error {
+        self.fatal = Some((kind, msg.clone()));
+        io::Error::new(kind, msg)
+    }
+
+    /// Read the next decrypted record payload into `out` (cleared first);
+    /// `Ok(None)` is the zero-chunk EOF (or a clean close at a record
+    /// boundary). The reader keeps its body buffer across records, so the
+    /// steady state allocates nothing per record.
+    pub(crate) fn poll_read_record(
+        &mut self,
+        cx: &mut Context<'_>,
+        out: &mut Vec<u8>,
+    ) -> Poll<io::Result<Option<()>>> {
+        loop {
+            if let Some((kind, msg)) = &self.fatal {
+                return Poll::Ready(Err(io::Error::new(*kind, msg.clone())));
+            }
+            if self.eof {
+                return Poll::Ready(Ok(None));
+            }
+            match self.stage {
+                ReadStage::Salt => {
+                    if self.head.len() != SALT_LEN {
+                        self.head.resize(SALT_LEN, 0u8);
+                    }
+                    match self
+                        .cache
+                        .poll_fill(cx, &mut self.head, &mut self.head_filled)
+                    {
+                        Poll::Pending => return Poll::Pending,
+                        Poll::Ready(Err(e)) => {
+                            let e = self.fail(e.kind(), e.to_string());
+                            return Poll::Ready(Err(e));
+                        }
+                        Poll::Ready(Ok(Fill::Eof)) => {
+                            self.eof = true;
+                            return Poll::Ready(Ok(None));
+                        }
+                        Poll::Ready(Ok(Fill::Done)) => {
+                            let key = match derive_key(&self.psk, &self.head[..SALT_LEN]) {
+                                Ok(key) => key,
+                                Err(e) => {
+                                    let e = self.fail(e.kind(), e.to_string());
+                                    return Poll::Ready(Err(e));
+                                }
+                            };
+                            self.cipher = Some(new_aead(&key));
+                            self.opener = Some(FastOpener::new(&key));
+                            self.nonce = [0; NONCE_LEN];
+                            self.head.resize(HEADER_CIPHER_LEN, 0u8);
+                            self.head_filled = 0;
+                            self.stage = ReadStage::Header;
+                        }
+                    }
+                }
+                ReadStage::Header => {
+                    match self
+                        .cache
+                        .poll_fill(cx, &mut self.head, &mut self.head_filled)
+                    {
+                        Poll::Pending => return Poll::Pending,
+                        Poll::Ready(Err(e)) => {
+                            let e = self.fail(e.kind(), e.to_string());
+                            return Poll::Ready(Err(e));
+                        }
+                        Poll::Ready(Ok(Fill::Eof)) => {
+                            self.eof = true;
+                            return Poll::Ready(Ok(None));
+                        }
+                        Poll::Ready(Ok(Fill::Done)) => {
+                            let opened = open_in_place(
+                                self.cipher.as_ref().expect("snell: reader initialized"),
+                                &self.nonce,
+                                &mut self.head,
+                            );
+                            if opened.is_err() {
+                                let e = self.fail(
+                                    io::ErrorKind::InvalidData,
+                                    "snell: open record header".to_string(),
+                                );
+                                return Poll::Ready(Err(e));
+                            }
+                            increase_nonce(&mut self.nonce);
+                            if self.head.len() != HEADER_PLAIN_LEN || self.head[0] != HEADER_VERSION
+                            {
+                                let version = self.head.first().copied().unwrap_or(0);
+                                let e = self.fail(
+                                    io::ErrorKind::InvalidData,
+                                    format!("snell: bad header version {version}"),
+                                );
+                                return Poll::Ready(Err(e));
+                            }
+                            self.padding_len =
+                                u16::from_be_bytes([self.head[3], self.head[4]]) as usize;
+                            self.payload_len =
+                                u16::from_be_bytes([self.head[5], self.head[6]]) as usize;
+                            if self.payload_len == 0 {
+                                // Zero-chunk tunnel EOF — header only on the
+                                // wire (reference `WriteZeroChunk`), not a
+                                // transport EOF: rearm the Header stage so the
+                                // pooled reader continues the same cipher
+                                // stream on the next reuse round.
+                                self.head.resize(HEADER_CIPHER_LEN, 0u8);
+                                self.head_filled = 0;
+                                self.stage = ReadStage::Header;
+                                return Poll::Ready(Ok(None));
+                            }
+                            let need = self.padding_len + self.payload_len + AEAD_TAG_LEN;
+                            if self.body.len() != need {
+                                // Resize, not replace: the capacity survives
+                                // the shrink and the next record reuses it.
+                                self.body.resize(need, 0u8);
+                            }
+                            self.body_filled = 0;
+                            self.stage = ReadStage::Body;
+                        }
+                    }
+                }
+                ReadStage::Body => {
+                    match self
+                        .cache
+                        .poll_fill(cx, &mut self.body, &mut self.body_filled)
+                    {
+                        Poll::Pending => return Poll::Pending,
+                        Poll::Ready(Err(e)) => {
+                            let e = self.fail(e.kind(), e.to_string());
+                            return Poll::Ready(Err(e));
+                        }
+                        Poll::Ready(Ok(Fill::Eof)) => {
+                            self.eof = true;
+                            return Poll::Ready(Ok(None));
+                        }
+                        Poll::Ready(Ok(Fill::Done)) => {
+                            let payload_end = self.padding_len + self.payload_len + AEAD_TAG_LEN;
+                            let payload_cipher_len = self.payload_len + AEAD_TAG_LEN;
+                            let limit = self.padding_len.min(payload_cipher_len);
+                            for index in (0..limit).step_by(2) {
+                                self.body.swap(index, self.padding_len + index);
+                            }
+                            let opened = self
+                                .opener
+                                .as_ref()
+                                .expect("snell: reader initialized")
+                                .open(&self.nonce, &mut self.body[self.padding_len..payload_end]);
+                            if opened.is_err() {
+                                let e = self.fail(
+                                    io::ErrorKind::InvalidData,
+                                    "snell: open record payload".to_string(),
+                                );
+                                return Poll::Ready(Err(e));
+                            }
+                            increase_nonce(&mut self.nonce);
+                            out.clear();
+                            out.extend_from_slice(
+                                &self.body[self.padding_len..self.padding_len + self.payload_len],
+                            );
+                            self.head.resize(HEADER_CIPHER_LEN, 0u8);
+                            self.head_filled = 0;
+                            self.stage = ReadStage::Header;
+                            return Poll::Ready(Ok(Some(())));
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+impl<R: AsyncRead + Unpin> RecordReader<R> {
+    pub(crate) async fn read_record(&mut self) -> io::Result<Option<Vec<u8>>> {
+        let mut out = Vec::new();
+        let found = std::future::poll_fn(|cx| match self.poll_read_record(cx, &mut out) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(Err(e)) => Poll::Ready(Err(e)),
+            Poll::Ready(Ok(found)) => Poll::Ready(Ok(found.is_some())),
+        })
+        .await?;
+        Ok(found.then_some(out))
+    }
+}
+
+// -------------------------------------------------------------- padding ----
+
+/// Reference `fillPadding`: pad toward a target ones/zeros ratio of the sealed
+/// payload cipher; random bytes when the ratio is out of bounds.
+fn fill_padding(padding: &mut [u8], payload_cipher: &[u8]) -> io::Result<()> {
+    if padding.is_empty() {
+        return Ok(());
+    }
+    let payload_count_len = payload_cipher.len() & !3;
+    let payload_ones = payload_cipher[..payload_count_len]
+        .iter()
+        .map(|b| b.count_ones())
+        .sum::<u32>() as i64;
+    let payload_zeros = 8 * payload_cipher.len() as i64 - payload_ones;
+    if payload_zeros <= 0 {
+        return random_bytes(padding);
+    }
+    let ratio = payload_ones as f64 / payload_zeros as f64;
+    if ratio <= 0.5 || ratio >= 1.6 {
+        return random_bytes(padding);
+    }
+    let target_ratio_base = if payload_zeros < payload_ones {
+        0.4
+    } else {
+        1.6
+    };
+    let random_value = f64::from(random_int31()?);
+    let target_ratio = target_ratio_base + random_value / 2147483647.0 / 10.0;
+    let total_bits = 8 * (padding.len() + payload_cipher.len());
+    let target_ones =
+        (total_bits as f64 * (target_ratio / (target_ratio + 1.0)) - payload_ones as f64) as i64;
+    if target_ones < 0 || target_ones > 8 * padding.len() as i64 {
+        return random_bytes(padding);
+    }
+    fill_padding_with_bit_count(padding, target_ones as usize)
+}
+
+/// Reference `fillPaddingWithBitCount`: place `one_bits` bits and shuffle them
+/// front-to-back with the reference division mapping (modulo bias kept).
+fn fill_padding_with_bit_count(padding: &mut [u8], one_bits: usize) -> io::Result<()> {
+    let total_bits = 8 * padding.len();
+    if one_bits > total_bits {
+        return Err(io::Error::other("snell: invalid padding bit count"));
+    }
+    let mut bitset = vec![0u8; total_bits];
+    bitset[..one_bits].fill(1);
+    let mut position = 0usize;
+    let mut remaining = total_bits;
+    while remaining != 1 {
+        let random_value = random_int31()?;
+        let divisor = 0x7fff_ffffusize.checked_div(remaining).unwrap_or(0);
+        let swap_index = position + (random_value as usize) / (divisor + 1);
+        bitset.swap(swap_index, position);
+        position += 1;
+        remaining -= 1;
+    }
+    padding.fill(0);
+    for (index, bit) in bitset.iter().enumerate() {
+        if *bit == 1 {
+            padding[index / 8] |= 1 << (index % 8);
+        }
+    }
+    Ok(())
+}
